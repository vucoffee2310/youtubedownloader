{
  "manifest_version": 3,
  "name": "Youtube Subtitle Downloader",
  "version": "3.8.0",
  "description": "Download subtitle from YouTube",
  "icons": { "48": "images/download-64.png" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["js/content.js"],
      "type": "module"
    }
  ],
  "permissions": ["webRequest", "webNavigation"],
  "host_permissions": [
    "https://www.youtube.com/api/timedtext?*",
    "https://www.youtube.com/watch?*"
  ],
  "background": { "service_worker": "js/background.js" },
  "web_accessible_resources": [
    {
      "resources": ["js/processor.js", "js/formats.js", "data.json"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
